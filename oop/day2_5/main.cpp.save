#include <iostream>

using namespace std;

int main()
{
    // take a number and print its factorial
    int result = 1, number = 0;
    cout << "enter a number : ";
    cin>>number;
    if(number<0)
    {
        cout <<"invalid";
        return 0;
    }
    if (number == 1)
    {
        result = number;
    }
    else
    {
        for(int i = number; i>1; i-- )
        {
            result *=i;
        }
    }
    cout << "factorial = " << result ;
    return 0;
}
