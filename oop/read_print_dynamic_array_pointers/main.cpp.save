#include <iostream>

using namespace std;

int main()
{
    int size = 0;
    cout << "enter size of array : ";
    cin >> size;

    int * ptr = new int[size];
    cout << "enter elements of array : " << endl;
    for (int i = 0; i < size; i ++ )
    {
        cout << "element [" << i+1<< "] : ";
        cin >> ptr[i];
    }
    cout << "==================\n"
    cout << "elements of the array : " << endl;
    for (int i = 0; i < size; i ++ )
    {
        cout <<"element ["<< i+1<<   "] = "<<  ptr[i]<< endl;
    }
    return 0;
}
