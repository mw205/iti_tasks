#include <iostream>

using namespace std;

class Stack
{

    int tos;
    int size;
    int* arr;
public:
    Stack(int _size)
    {
        tos=-1;
        size=_size;
        arr= new int [size];
    }

    void push(int x)
    {
        if(tos<size-1)
        {
            tos++;
            arr[tos]=x;
        }
        else
        {
            cout <<"Stack is full!!";
        }
    }

    int pop(int& x)
    {
        if(tos>=0)
        {
            x= arr[tos];
            tos--;
            return 1;
        }
        else
        {
            cout << "Stack is Empty";
            return 0;
        }
    }
    void peek()
    {
        if(tos!=-1)
        {
            cout << "top element : "<< arr[tos] << endl;
        }
        else
        {
            cout << "\nStack is Empty\n";
        }
    }
    // copy constructor

    Stack(Stack& s)
    {
        tos = s.tos ;
        size = s.size;
        arr = new int[size];
        cout << "tos: " << tos << endl << "size : "<< size << endl;
        for (int i = 0 ; i < tos+1 ; i ++)
        {
            arr[i] = s.arr[i] ;
        }
        for(int i = 0 ; i < tos+1 ; i ++){
            cout << arr[i] << " " ;
        }
        e
    }

    // destructor
    ~Stack()
    {
        delete[]arr;
    }
};
