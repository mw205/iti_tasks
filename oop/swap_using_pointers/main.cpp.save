#include <iostream>

using namespace std;

int main()
{
    int x, y ;

    cout << "enter elements to swap "<< endl;
    cout << "the first element : ";
    cin>> x;
    cout << "the second element : ";
    cin>> y;
    int*a= &x, b = &y;
    swap(a, b);
    cout << "After Swap : \n";
    cout << "first one becomes : "<< x ;
    cout << "second one becomes : "<< y ;
    return 0;
}
c{
    int temp = *x ;
    *x = *y;
    *y = *temp;
}
