<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- List View -->
    <record id="view_hms_patient_tree" model="ir.ui.view">
        <field name="name">hms.patient.list</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="email" widget="email" />
                <field name="age"/>
                <field name="blood_type"/>
                <field name="pcr"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hms_patient_form" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="first_name" string="Patient Name"/>
                        <h1>
                            <div class="d-flex">
                                <field name="first_name" placeholder="First Name" class="me-2"/>
                                <field name="last_name" placeholder="Last Name"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Details">
                            <field name="email" widget="email" />
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                        <group string="Medical Details">
                            <field name="pcr"/>
                            <field name="cr_ratio" invisible="not pcr" required="pcr"/>
                            <field name="address"/>
                        </group>
                    </group>

                    <group string="Medical History" invisible="age &lt; 50">
                        <field name="history" placeholder="Enter patient medical history..."/>
                    </group>

                    <group string="Hospital Information">
                        <group>
                            <field name="department_id" domain="[('is_opened', '=', True)]"/>
                            <field name="department_capacity" readonly="1"/>
                        </group>
                        <group>
                            <field name="doctor_ids" widget="many2many_tags" readonly="not department_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Log History">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="create_uid" string="Created By"/>
                                    <field name="create_date" string="Date"/>
                                    <field name="description" string="Description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main Menu -->
    <menuitem id="menu_hms_root" name="HMS"/>

    <!-- Patients Menu -->
    <menuitem id="menu_hms_patient" name="Patients" parent="menu_hms_root" action="action_hms_patient"/>

</odoo>
