#include <bits/stdc++.h>

using namespace std;

int min (int x,int y)
{
    if (x< y)
    {
        return x;
    }
    else
    {
        return y;
    }
}
int max(int x,int y){
    if (x> y){
        return x;
    }
    else{
        return y;
    }
}
int main()
{
    int l1, r1, l2,r2, intersection_start , intersection_end;
    cin >> l1 >> r1 >> l2 >> r2;
    intersection_start = ma(l1,l2);
    intersection_end = max(r1,r2);
    if(intersection_start<=intersection_end){
        cout << intersection_start << " " << intersection_end;
    }
    else{
        cout << -1;
    }
    return 0;
}
