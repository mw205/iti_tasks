#include <iostream>

using namespace std;

int factorialWithLoop(int x)
{
    int result = 1;
    for(int i = 2; i<= x; i++)
    {
        result *= i;
    }
    return result;
}
int main()
{
    int t, n;
    cin >> t;
    for(int i = 0 ; i<t; i++)
    {
        cin>>n;
        cout << factorialWithLoop(n)<< endl;

    }
    return 0;
}
