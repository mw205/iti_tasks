#include <bits/stdc++.h>
using namespace std;

void rightOrWrong(bool x)
{
    if(x)
    {
        cout << "Right";
    }
    else
    {
        cout << "Wrong";
    }
}
int main()
{
    int x,y;
    char op;
    cin >> x>>op>>y;
    switch (op)
    {
    case '>':
        rightOrWrong(x>y);
        break;

    case '<':
        rightOrWrong(x<y);
        break;
    default:
        rightOrWrong(x==y);
        break;
    }


    return 0;
}
